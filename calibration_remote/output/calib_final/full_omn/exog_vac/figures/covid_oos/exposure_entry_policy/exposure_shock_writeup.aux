\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Robustness of the policy effect across behavioural model variants (Eloundou et al. exposure score), over the full 20-year (240-month) shock horizon. Each line shows the policy effect (policy minus no-policy), paired by warm-started simulation and averaged across $N=10$ simulations per variant. Panels A-B (entry-level occupations only): unemployment rate and failed-hire rate. Panels C-D (\emph  {all} occupations, unlike A-B, so as to capture spillover effects on the rest of the economy): the wage of every currently employed worker in scope, not only new hires -- Panel C relative to each occupation's own median wage (isolating within-occupation pay changes), Panel D as a raw dollar level (which also reflects any compositional shift in which occupations people work in). Shaded bands show 95\% confidence intervals.}}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:crossmodel}{{2}{7}{Robustness of the policy effect across behavioural model variants (Eloundou et al. exposure score), over the full 20-year (240-month) shock horizon. Each line shows the policy effect (policy minus no-policy), paired by warm-started simulation and averaged across $N=10$ simulations per variant. Panels A-B (entry-level occupations only): unemployment rate and failed-hire rate. Panels C-D (\emph {all} occupations, unlike A-B, so as to capture spillover effects on the rest of the economy): the wage of every currently employed worker in scope, not only new hires -- Panel C relative to each occupation's own median wage (isolating within-occupation pay changes), Panel D as a raw dollar level (which also reflects any compositional shift in which occupations people work in). Shaded bands show 95\% confidence intervals}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Lifetime earnings of entrants}{8}{subsection.3.5}\protected@file@percent }
\newlabel{sec:lifetime}{{3.5}{8}{Lifetime earnings of entrants}{subsection.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Robustness of the lifetime-earnings effect (Figure~\ref {fig:lifetime}) across behavioural model variants (Eloundou et al. exposure score). Same cohort, follow-up window, and paired-$\Delta $-by- simulation procedure as Figure~\ref {fig:lifetime}, repeated independently for each of the three cross-model variants (Section~\ref {sec:crossmodel}), one line per model, coloured as in Figure~\ref {fig:crossmodel}. Top row (Panels A-B) uses the per-simulation cohort \emph  {median}, the statistic used everywhere else in this note; bottom row (Panels C-D) repeats the same comparison using the per-simulation cohort \emph  {mean} instead, shown purely as a robustness check on that choice. Panels A/C: $\Delta $ cumulative earnings relative to entry-occupation median wage. Panels B/D: $\Delta $ cumulative raw dollar earnings. $N=10$ simulations per variant, shaded bands show 95\% confidence intervals.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:crossmodel-lifetime}{{3}{10}{Robustness of the lifetime-earnings effect (Figure~\ref {fig:lifetime}) across behavioural model variants (Eloundou et al. exposure score). Same cohort, follow-up window, and paired-$\Delta $-by- simulation procedure as Figure~\ref {fig:lifetime}, repeated independently for each of the three cross-model variants (Section~\ref {sec:crossmodel}), one line per model, coloured as in Figure~\ref {fig:crossmodel}. Top row (Panels A-B) uses the per-simulation cohort \emph {median}, the statistic used everywhere else in this note; bottom row (Panels C-D) repeats the same comparison using the per-simulation cohort \emph {mean} instead, shown purely as a robustness check on that choice. Panels A/C: $\Delta $ cumulative earnings relative to entry-occupation median wage. Panels B/D: $\Delta $ cumulative raw dollar earnings. $N=10$ simulations per variant, shaded bands show 95\% confidence intervals}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Single-Model Policy Effect}{11}{section.4}\protected@file@percent }
\newlabel{sec:single}{{4}{11}{Single-Model Policy Effect}{section.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Lifetime-earnings effect of entry-level preferential hiring under the AI-exposure shock (Eloundou et al. exposure score): policy minus no-policy, paired by warm-started simulation. Cohort: workers who enter the labour force during the shock's 5-year ramp-in window, tracked for 15 years following that window. A year unemployed at the annual snapshot counts as \$0 that year. Panel A: $\Delta $ cumulative earnings relative to the worker's entry-occupation median wage (fixed at entry, not re-based on later occupation changes -- see Section~\ref {sec:lifetime}). Panel B: $\Delta $ cumulative raw dollar earnings, no normalisation. Paired at the level of the warm-started simulation, not the individual entrant; $N=10$ simulations per scenario, shaded bands show 95\% confidence intervals.}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{fig:lifetime}{{4}{11}{Lifetime-earnings effect of entry-level preferential hiring under the AI-exposure shock (Eloundou et al. exposure score): policy minus no-policy, paired by warm-started simulation. Cohort: workers who enter the labour force during the shock's 5-year ramp-in window, tracked for 15 years following that window. A year unemployed at the annual snapshot counts as \$0 that year. Panel A: $\Delta $ cumulative earnings relative to the worker's entry-occupation median wage (fixed at entry, not re-based on later occupation changes -- see Section~\ref {sec:lifetime}). Panel B: $\Delta $ cumulative raw dollar earnings, no normalisation. Paired at the level of the warm-started simulation, not the individual entrant; $N=10$ simulations per scenario, shaded bands show 95\% confidence intervals}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Effect of entry-level preferential hiring under the AI-exposure shock (Eloundou et al. exposure score). Panel A: unemployment rate. Panel B: first-job wage relative to occupation median wage. Panel C: failed-hire rate. Panel D: economy-wide UE and EE transition rates. Solid lines: entry-level occupations; dotted lines (Panels A--C): rest of the economy. Grey: no policy; purple: entry-level preferential hiring. $N=10$ warm-started simulations per scenario; shaded bands show 95\% confidence intervals.}}{12}{figure.caption.7}\protected@file@percent }
\newlabel{fig:main}{{5}{12}{Effect of entry-level preferential hiring under the AI-exposure shock (Eloundou et al. exposure score). Panel A: unemployment rate. Panel B: first-job wage relative to occupation median wage. Panel C: failed-hire rate. Panel D: economy-wide UE and EE transition rates. Solid lines: entry-level occupations; dotted lines (Panels A--C): rest of the economy. Grey: no policy; purple: entry-level preferential hiring. $N=10$ warm-started simulations per scenario; shaded bands show 95\% confidence intervals}{figure.caption.7}{}}
